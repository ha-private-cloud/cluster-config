persistence:
  enabled: true
  storageSize: ${storage_size}

nexus:
  env:
    - name: INSTALL4J_ADD_VM_PARAMS
      value: >-
        -Xms768M -Xmx768M
        -XX:MaxDirectMemorySize=512M
        -XX:+UnlockExperimentalVMOptions
        -XX:+UseCGroupMemoryLimitForHeap
        -Djava.util.prefs.userRoot=/nexus-data/javaprefs
    - name: NEXUS_SECURITY_RANDOMPASSWORD
      value: "true"
  resources:
    requests:
      cpu: "1"
      memory: 1536Mi
    limits:
      cpu: "2"
      memory: 2Gi
  livenessProbe:
    initialDelaySeconds: 60
    periodSeconds: 15
    failureThreshold: 40
    timeoutSeconds: 10
    path: /
  readinessProbe:
    initialDelaySeconds: 60
    periodSeconds: 15
    failureThreshold: 40
    timeoutSeconds: 10
    path: /

  docker:
    enabled: true
    registries:
      - host: ${docker_hostname}
        port: ${docker_port}
        secretName: ${ingress_tls_secret_name}

ingress:
  enabled: true
  ingressClassName: nginx
  hostRepo: ${hostname}
  tls:
    - hosts:
        - ${hostname}
      secretName: ${ingress_tls_secret_name}
