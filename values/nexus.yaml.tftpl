persistence:
  enabled: true
  storageSize: ${storage_size}
  # No storageClass set: nfs-csi is the cluster's only/default StorageClass
  # (see csi-driver-nfs.tf), so the default provisioner is used.

nexus:
  # Sized to fit this homelab's 4 vCPU/4GB worker VMs without starving
  # other pods on the same node.
  resources:
    requests:
      cpu: "1"
      memory: 1Gi
    limits:
      cpu: "2"
      memory: 2Gi

  # Nexus's JVM takes several minutes to finish first-boot startup on this
  # hardware, so give the probes enough time to avoid killing it mid-init.
  livenessProbe:
    initialDelaySeconds: 60
    periodSeconds: 15
    failureThreshold: 40
    timeoutSeconds: 10
    path: /
  readinessProbe:
    initialDelaySeconds: 60
    periodSeconds: 15
    failureThreshold: 40
    timeoutSeconds: 10
    path: /

  docker:
    enabled: true
    registries:
      - host: ${docker_hostname}
        port: ${docker_port}
        # Same "accept self-signed" pattern as everywhere else in this
        # cluster (see headlamp.tf/values): this secret is never created,
        # so ingress-nginx falls back to its default self-signed cert for
        # this host instead of failing the Ingress.
        secretName: nexus-docker-tls

ingress:
  enabled: true
  ingressClassName: nginx
  hostRepo: ${hostname}
  tls:
    - hosts:
        - ${hostname}
      secretName: nexus-ui-tls
